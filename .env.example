# Demo values. Good enough for the prototype; docker-compose.yml carries the same defaults,
# so `docker compose up` works without a .env file.
#
# CLIENT_SECRET must match the client "community-app" in keycloak/realm-example.json.
CLIENT_SECRET=community-app-demo-secret
# Signs the community app's own cookies (auth state during login, its login session with the
# profile). Known only to that app.
APP_SECRET=demo-community-app-secret-please-change-0123456789
KC_ADMIN_PASSWORD=admin
WP_ADMIN_PASSWORD=admin
# Everything the edge needs is listed in edge/edge.env.example; the same EDGE_* names work here
# and override the prototype's defaults. EDGE_LOGIN_COOKIE_KEY is shared with the community app.
#EDGE_LOGIN_COOKIE_NAME=example_login
#EDGE_LOGIN_COOKIE_KEY=ZGVtby1sb2dpbi1jb29raWUta2V5LTMyLWJ5dGVzISE=
#EDGE_OIDC_ISSUER=http://auth.example.localhost:8080/realms/example
#EDGE_ROLE_CLAIM=example_role
#EDGE_ROLE_HEADER=X-Example-Role
#EDGE_REFRESH_URL=http://community.example.localhost:8001/auth/refresh
#EDGE_CACHE_DEFAULT_TTL=60
