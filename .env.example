# Demo values. Good enough for the prototype; docker-compose.yml carries the same defaults,
# so `docker compose up` works without a .env file.
#
# CLIENT_SECRET must match the client "example-web" in keycloak/realm-example.json.
CLIENT_SECRET=example-web-demo-secret
# Signs the role JWT in the cookie (HS256); shared by the auth service and Varnish.
# In production: random, >= 32 bytes, rotatable.
SESSION_SECRET=demo-session-secret-please-change-0123456789abcdef
KC_ADMIN_PASSWORD=admin
WP_ADMIN_PASSWORD=admin
# Lifetime of the role JWT. After that, a silent re-login at the IdP.
SESSION_TTL_SECONDS=900
# The cookie outlives the JWT so that an expired JWT can trigger the silent re-login.
SESSION_COOKIE_MAX_AGE_SECONDS=43200
# Cache TTL when WordPress sends neither s-maxage nor max-age.
DEFAULT_CACHE_TTL_SECONDS=60
