# Demo values. Good enough for the prototype; docker-compose.yml carries the same defaults,
# so `docker compose up` works without a .env file.
#
# CLIENT_SECRET must match the client "community-app" in keycloak/realm-example.json.
CLIENT_SECRET=community-app-demo-secret
# Signs the community app's own cookies (auth state during login, its login session with the
# profile). Known only to that app.
APP_SECRET=demo-community-app-secret-please-change-0123456789
KC_ADMIN_PASSWORD=admin
WP_ADMIN_PASSWORD=admin
# AES-256 key (32 bytes, base64) that encrypts the domain-wide login cookie. Shared between the
# community app and HAProxy. Protects confidentiality only; forging a login would still need the
# IdP's signature. Generate with: openssl rand -base64 32
LOGIN_COOKIE_KEY=ZGVtby1sb2dpbi1jb29raWUta2V5LTMyLWJ5dGVzISE=
# The login cookie outlives the id_token so that an expired token can trigger the silent re-login.
# The id_token lifetime itself (= website session length) is accessTokenLifespan in the realm.
COOKIE_MAX_AGE_SECONDS=43200
# Cache TTL when WordPress sends neither s-maxage nor max-age.
DEFAULT_CACHE_TTL_SECONDS=60

# Pointing the local edge at a real community app and IdP (all optional; defaults are the
# prototype's own services). Together with the matching LOGIN_COOKIE_KEY and the IdP's public key
# in haproxy/idp-public.pem (scripts/fetch-idp-key.sh), this lets a cookie copied from a real login
# be checked against the local HAProxy with curl.
#EDGE_LOGIN_COOKIE_NAME=__Secure-example_login
#EDGE_OIDC_ISSUER=https://idp.example.org
#EDGE_ROLE_CLAIM=role
#EDGE_ROLE_HEADER=X-Example-Role
#EDGE_REFRESH_URL=https://community.example.org/api/1.0/auth/refresh
