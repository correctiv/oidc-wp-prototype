# Everything the edge (HAProxy + Varnish) needs, one value each. HAProxy reads these directly;
# render-vcl.sh substitutes the ${EDGE_*} placeholders in the VCL template from them.
# The values below are the prototype's.

# Name of the domain-wide login cookie the community app sets.
EDGE_LOGIN_COOKIE_NAME=example_login
# 32-byte AES-256-GCM key, base64, shared with the community app. Protects confidentiality only:
# a holder can read tokens, not forge them. Generate with: openssl rand -base64 32
EDGE_LOGIN_COOKIE_KEY=ZGVtby1sb2dpbi1jb29raWUta2V5LTMyLWJ5dGVzISE=
# Expected iss claim of the id_token.
EDGE_OIDC_ISSUER=http://auth.example.localhost:8080/realms/example
# PEM file with the IdP's RSA public key, inside the HAProxy container. bin/fetch-idp-key.sh
# produces it from the IdP's JWKS.
EDGE_IDP_PUBLIC_KEY_FILE=/usr/local/etc/haproxy/idp-public.pem
# Claim in the id_token that holds the access level.
EDGE_ROLE_CLAIM=example_role
# Header that carries the level from HAProxy through Varnish to WordPress.
EDGE_ROLE_HEADER=X-Example-Role
# The community app's silent-refresh endpoint; expired tokens on HTML navigations are sent there.
EDGE_REFRESH_URL=http://community.example.localhost:8001/auth/refresh
# Varnish default TTL in seconds when the origin sends neither s-maxage nor max-age.
EDGE_CACHE_DEFAULT_TTL=60
